# Secrets and local configuration
.env
.env.local

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Java
backend/target/
*.class

# Model artifacts are regenerated by run_all; the trained model is large
# and reproducible from a fixed seed.
ml-service/artifacts/*.joblib

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Secrets: ignore every env file except the example
.env.*
!.env.example

# Backups, Office lock files, local packages
*.backup
~$*
deliverables/
deliverables.zip

# Duplicate submission bundles and LaTeX build output
paper/submission/
paper/ieee-transactions/*.aux
paper/ieee-transactions/*.log
paper/ieee-transactions/*.out
paper/ieee-transactions/*.generated-*.tex

# Only if you are NOT publishing the invention disclosure
docs/ip/
