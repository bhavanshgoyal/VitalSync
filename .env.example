# VitalSync configuration.
#
# Copy to .env and edit. docker compose reads .env automatically.
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.

# ----------------------------------------------------------------- ports
VITALSYNC_PORT=8080
VITALSYNC_ML_PORT=8000
VITALSYNC_DB_PORT=5432

# -------------------------------------------------------------- database
VITALSYNC_DB_PASSWORD=vitalsync

# -------------------------------------------------------------- security
# Must be at least 32 bytes for HS256. The default below is a known demo
# value and is safe ONLY on a machine nobody else can reach.
# Generate a real one:  openssl rand -base64 48
VITALSYNC_JWT_SECRET=change-me-vitalsync-demo-secret-key-32b
VITALSYNC_DEMO_USER=clinician
VITALSYNC_DEMO_PASSWORD=vitalsync-demo


# =========================================================================
# LLM SUMMARIZATION TIERS
# =========================================================================
# Both are OFF by default. With both off the system is fully functional:
# the deterministic tier produces every summary and nothing fails.
#
# Turning either on is what populates the currently-empty LLM results
# section of the paper. After enabling, run:
#
#     python bench/llm_evaluation.py
#
# which writes ml-service/artifacts/llm_evaluation.json, and then:
#
#     python paper/make_tables.py
#
# which generates paper/tables/table_llm.tex and fills the section in.

# --------------------------------------------------- tier 1: Ollama (local)
# Install Ollama, then:  ollama pull llama3.1:8b
#
# From inside Docker the host is reachable as host.docker.internal.
# Running the backend outside Docker? Use http://localhost:11434
VITALSYNC_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=20

# --------------------------------------------------- tier 2: Gemini (cloud)
# Key from https://aistudio.google.com/apikey
#
# NOTE: enabling this sends simulated telemetry to Google. It is synthetic
# data here, so that is fine. Never point this at real patient data without
# a data-processing agreement in place.
VITALSYNC_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=20

# ------------------------------------------------------------- ML service
VITALSYNC_ML_CONNECT_TIMEOUT_MS=2000
VITALSYNC_ML_READ_TIMEOUT_MS=5000

# ------------------------------------------------------------------- misc
VITALSYNC_LOG_LEVEL=INFO

# Track A only. Leave unset to auto-discover the kagglehub cache.
# VITALSYNC_KAGGLE_CSV=
